# Backend environment variables (example)
#
# Copy to .env (do not commit .env) and fill in values.
# This API validates Supabase access tokens via JWKS (RS256). The runtime MUST
# install Python dependencies from pyproject.toml (PyJWT provides the `jwt` module).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Optional: override the JWKS endpoint. If empty, backend derives it from SUPABASE_URL:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Optional: expected JWT audience claim. Leave empty to skip audience validation.
SUPABASE_JWT_AUDIENCE=

# Database connection string (example)
DATABASE_URL=

# Comma-separated list of allowed browser origins for CORS.
# Local dev (React @ 3000):
# CORS_ORIGINS=http://localhost:3000
# Local dev (Vite @ 5173 + React @ 3000):
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
