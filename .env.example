# Backend environment variables (FastAPI)

# Database connection (Supabase Postgres in production)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/workorders

# CORS configuration: comma-separated origins
CORS_ORIGINS=http://localhost:5173

# Supabase Auth JWT validation (HS256)
# Obtain from Supabase Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=

# DEV-only: enable legacy identity shim via X-User-Role / X-User-Name headers.
# MUST be false in production.
ENABLE_DEV_IDENTITY_SHIM=true
