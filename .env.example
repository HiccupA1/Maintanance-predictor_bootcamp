# Copy to .env and adjust for your environment.
# NOTE: The orchestrator/deployment sets the real .env; do not commit secrets.

# SQLAlchemy database URL (PostgreSQL for real runs).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/workorders

# Optional OpenAPI metadata overrides.
APP_NAME=Work Order Management API
APP_VERSION=0.2.0

# Base URI used to build RFC7807 problem "type" values per error code.
PROBLEM_BASE_URI=https://api.workorders.local/errors
CORS_ORIGINS=
