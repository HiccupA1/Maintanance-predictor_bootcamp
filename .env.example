# Backend environment variables (example)
# Copy to Maintanance-predictor_bootcamp/.env and fill in values.
#
# NOTE:
# - This backend reads Maintanance-predictor_bootcamp/.env via Pydantic settings.
# - Do NOT commit real secrets.

# =========================
# Database (Supabase Postgres)
# =========================
# Use the Supabase Postgres connection string (Project Settings -> Database).
# The backend uses SQLAlchemy, and expects a psycopg2 URL.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# =========================
# Supabase (API keys)
# =========================
# Supabase project URL (Dashboard -> Project Settings -> API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...) - safe for browser use, but the backend may
# keep it for diagnostics or optional integrations.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_SUPABASE_PUBLISHABLE_KEY

# Secret key (sb_secret_...) - server-only, MUST NOT be exposed to frontend.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SUPABASE_SECRET_KEY

# =========================
# Supabase Auth (JWT verification)
# =========================
# The backend verifies Authorization: Bearer <token> using Supabase JWKS (RS256).
# By default, JWKS URL is derived as:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# If your environment needs an explicit URL, set SUPABASE_JWKS_URL.
SUPABASE_JWKS_URL=

# Optional: validate the `aud` claim.
# Many Supabase access tokens use "authenticated". Leave empty to skip aud check.
SUPABASE_JWT_AUDIENCE=authenticated

# =========================
# DEV-only identity shim
# =========================
# When true, GET /v1/me can fall back to X-User-Role / X-User-Name headers
# if NO Authorization header is supplied. Recommended: false when using real Supabase auth.
ENABLE_DEV_IDENTITY_SHIM=false

# =========================
# Optional: CORS (comma-separated)
# =========================
# Example:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=
