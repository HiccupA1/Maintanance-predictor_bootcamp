{
  "flow": "manual",
  "title": "Manual process: spreadsheet logbook, threshold sheet, email, work-order register, asset register",
  "status": "Assumed. To be validated by a DigitalT3 lead or the client's maintenance team (Docs/stage-9/workflow-baseline-sop.md).",
  "notes": [
    "Same scenario and the same free text as the app flow, so typing effort is comparable.",
    "Everything happens at a desktop computer, so the Keystroke-Level Model applies to every step. Paper logbooks would be slower; this baseline is deliberately favourable to the manual process.",
    "Only actions for this one incident are counted. No time is spent waiting for a reply."
  ],
  "actions": [
    {"actor": "Operator", "type": "navigate", "description": "Open the readings logbook spreadsheet"},
    {"actor": "Operator", "type": "lookup", "description": "Find the machine's sheet and the next empty row"},
    {"actor": "Operator", "type": "type", "chars": 16, "description": "Type the date and time (2026-11-22 09:14)"},
    {"actor": "Operator", "type": "type", "chars": 18, "description": "Type the machine name (Cooling pump P-101)"},
    {"actor": "Operator", "type": "type", "chars": 11, "description": "Type the parameter (Temperature)"},
    {"actor": "Operator", "type": "type", "chars": 2, "description": "Type the reading (95)"},
    {"actor": "Operator", "type": "type", "chars": 12, "description": "Type own name (Olu Operator)"},
    {"actor": "Operator", "type": "navigate", "description": "Open the threshold reference sheet"},
    {"actor": "Operator", "type": "lookup", "description": "Find the machine and parameter limits"},
    {"actor": "Operator", "type": "compare", "description": "Compare the reading against the limits"},
    {"actor": "Operator", "type": "type", "chars": 6, "description": "Mark the logbook row as BREACH"},
    {"actor": "Operator", "type": "click", "description": "Save the logbook"},
    {"actor": "Operator", "type": "navigate", "description": "Open the email client and start a new message"},
    {"actor": "Operator", "type": "type", "chars": 22, "description": "Address it to the plant manager"},
    {"actor": "Operator", "type": "type", "chars": 32, "description": "Subject: Temperature breach P-101"},
    {"actor": "Operator", "type": "type", "chars": 78, "description": "Body: machine, parameter, value, limit, time"},
    {"actor": "Operator", "type": "click", "description": "Send the email"},

    {"actor": "PlantManager", "type": "navigate", "description": "Open the email"},
    {"actor": "PlantManager", "type": "navigate", "description": "Open the work-order register spreadsheet"},
    {"actor": "PlantManager", "type": "lookup", "description": "Find the next work-order number"},
    {"actor": "PlantManager", "type": "type", "chars": 6, "description": "Type the work-order number"},
    {"actor": "PlantManager", "type": "navigate", "description": "Open the asset register"},
    {"actor": "PlantManager", "type": "lookup", "description": "Find the machine's location and criticality"},
    {"actor": "PlantManager", "type": "navigate", "description": "Switch back to the work-order register"},
    {"actor": "PlantManager", "type": "type", "chars": 18, "description": "Type the machine name"},
    {"actor": "PlantManager", "type": "type", "chars": 6, "description": "Type the location (Hall 2)"},
    {"actor": "PlantManager", "type": "type", "chars": 20, "description": "Type the description (Inspect cooling loop)"},
    {"actor": "PlantManager", "type": "type", "chars": 4, "description": "Type the priority (HIGH)"},
    {"actor": "PlantManager", "type": "type", "chars": 30, "description": "Type the alert reference (reading, limit, time)"},
    {"actor": "PlantManager", "type": "type", "chars": 12, "description": "Type the assignee"},
    {"actor": "PlantManager", "type": "click", "description": "Save the register"},
    {"actor": "PlantManager", "type": "navigate", "description": "Start a new email"},
    {"actor": "PlantManager", "type": "type", "chars": 22, "description": "Address it to the engineer"},
    {"actor": "PlantManager", "type": "type", "chars": 28, "description": "Subject: Work order WO-0142"},
    {"actor": "PlantManager", "type": "type", "chars": 60, "description": "Body: work-order number, machine, what to do"},
    {"actor": "PlantManager", "type": "click", "description": "Send the email"},

    {"actor": "MaintenanceEngineer", "type": "navigate", "description": "Open the email"},
    {"actor": "MaintenanceEngineer", "type": "navigate", "description": "Open the work-order register"},
    {"actor": "MaintenanceEngineer", "type": "lookup", "description": "Find the work-order row"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 6, "description": "Type the status (CLOSED)"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 21, "description": "Type the resolution notes (Replaced worn bearing)"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 12, "description": "Type the root cause (Bearing wear)"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 3, "description": "Type whether it was a real failure (Yes)"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 9, "description": "Type the failure mode (Tool wear)"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 16, "description": "Type the closure date and time"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 12, "description": "Type own name as closer"},
    {"actor": "MaintenanceEngineer", "type": "click", "description": "Save the register"},
    {"actor": "MaintenanceEngineer", "type": "navigate", "description": "Open the asset register"},
    {"actor": "MaintenanceEngineer", "type": "lookup", "description": "Find the machine's row"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 10, "description": "Type the last-service date"},
    {"actor": "MaintenanceEngineer", "type": "click", "description": "Save the asset register"},
    {"actor": "MaintenanceEngineer", "type": "navigate", "description": "Reply to the plant manager"},
    {"actor": "MaintenanceEngineer", "type": "type", "chars": 40, "description": "Body: work order closed, root cause"},
    {"actor": "MaintenanceEngineer", "type": "click", "description": "Send the email"},

    {"actor": "PlantManager", "type": "navigate", "description": "Open the reply"},
    {"actor": "PlantManager", "type": "navigate", "description": "Open the readings logbook"},
    {"actor": "PlantManager", "type": "lookup", "description": "Find the BREACH row"},
    {"actor": "PlantManager", "type": "type", "chars": 8, "description": "Mark it RESOLVED"},
    {"actor": "PlantManager", "type": "click", "description": "Save the logbook"}
  ]
}
