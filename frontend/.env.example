# Backend API base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Auth mode:
# - supabase: production mode; uses Supabase Auth and sends Authorization Bearer JWT to backend
# - dev_shim: development mode; uses X-User-Role/X-User-Name header-based shim
VITE_AUTH_MODE=supabase

# TEMPORARY / DEV-ONLY: bypass frontend authentication + route guards entirely.
# Set to true to skip login and render the app shell + screens directly.
# IMPORTANT: do not use in production.
VITE_BYPASS_AUTH=false

# Supabase (required when VITE_AUTH_MODE=supabase)
VITE_SUPABASE_URL=https://jbloqfbkfwdjvyrzxauz.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
