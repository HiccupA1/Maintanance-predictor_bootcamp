{
  "name": "maintenance-predictor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Work Orders journey UI for the Predictive Maintenance Alert & Work Order System.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:no-opt": "VITE_NO_OPTIMIZE=1 node ./node_modules/vite/bin/vite.js",
    "dev:safe": "VITE_SAFE_MODE=1 node ./node_modules/vite/bin/vite.js",
    "dev:safe:preview": "VITE_SAFE_MODE=1 node ./node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3000",
    "dev:no-opt:preview": "VITE_NO_OPTIMIZE=1 node ./node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3000",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js src",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.13",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "csstype": "3.1.3"
  }
}
