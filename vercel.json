{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci --no-audit --no-fund",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
